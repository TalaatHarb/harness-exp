<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="net.talaatharb.harness.ui.sections.MemorySectionController" spacing="10" styleClass="section">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <Label text="Memory" styleClass="section-title"/>
    <Label wrapText="true" styleClass="section-help"
           text="Long-term memory shared by all conversations. The agent saves facts with the remember tool (near-duplicates are skipped) and searches them with recall. The context builder's 'memory' stage adds the memories relevant to each message. Memories are kept as markdown files (one &lt;id&gt;.md each, easy to edit or sync) or in a MapDB file; set the locations in the Storage tab. Edits here are saved straight away; the backend and numbers below apply with Apply/Save."/>
    <HBox spacing="6" alignment="CENTER_LEFT">
        <Label text="Backend:"/>
        <ComboBox fx:id="backendCombo" prefWidth="130"/>
        <TextField fx:id="locationField" editable="false" HBox.hgrow="ALWAYS" styleClass="mono"/>
        <Button text="⟳ Refresh" onAction="#onRefresh">
            <tooltip><Tooltip text="Re-read the memories (picks up files edited outside the app and agent-saved memories)"/></tooltip>
        </Button>
    </HBox>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Memories in context"/>
        <Spinner fx:id="contextSpinner" prefWidth="80">
            <tooltip><Tooltip text="Most memories added to the context for one message (0 = none)"/></tooltip>
        </Spinner>
        <Label text="Recall results"/>
        <Spinner fx:id="recallSpinner" prefWidth="80"/>
        <Label text="Duplicate threshold (%)"/>
        <Spinner fx:id="duplicateSpinner" prefWidth="80">
            <tooltip><Tooltip text="remember skips a new memory when this share of its words is already in an existing one"/></tooltip>
        </Spinner>
    </HBox>
    <HBox spacing="6" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search memories…" HBox.hgrow="ALWAYS"/>
        <Label fx:id="statusLabel" styleClass="status"/>
    </HBox>
    <HBox spacing="12" VBox.vgrow="ALWAYS">
        <VBox spacing="6" prefWidth="300">
            <ListView fx:id="memoryList" VBox.vgrow="ALWAYS"/>
            <HBox spacing="6">
                <Button text="New" onAction="#onAdd"/>
                <Button fx:id="deleteButton" text="Delete" onAction="#onDelete"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="copyButton" onAction="#onCopyAll"/>
            </HBox>
        </VBox>
        <VBox fx:id="form" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Memory"/>
            <TextArea fx:id="textArea" wrapText="true" VBox.vgrow="ALWAYS"
                      promptText="One short, self-contained fact, e.g. &quot;The user prefers metric units.&quot;"/>
            <Label text="Tags (comma separated)"/>
            <TextField fx:id="tagsField"/>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label fx:id="infoLabel" styleClass="section-help" wrapText="true"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="revertButton" text="Revert" onAction="#onRevert"/>
                <Button fx:id="saveButton" text="Save memory" onAction="#onSave"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
