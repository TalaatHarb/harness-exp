<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="net.talaatharb.harness.ui.sections.ToolsSectionController" spacing="10" styleClass="section">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <Label text="Tools" styleClass="section-title"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <CheckBox fx:id="toolsEnabledCheck" text="Allow the agent to call tools"/>
        <Label text="Max tool output (chars)"/>
        <Spinner fx:id="maxOutputSpinner" prefWidth="110"/>
    </HBox>
    <TableView fx:id="toolTable" editable="true" prefHeight="180">
        <columns>
            <TableColumn fx:id="toolEnabledCol" text="On" prefWidth="40"/>
            <TableColumn fx:id="toolNameCol" text="Name" prefWidth="130"/>
            <TableColumn fx:id="toolRiskCol" text="Risk" prefWidth="90"/>
            <TableColumn fx:id="toolSourceCol" text="Source" prefWidth="90"/>
            <TableColumn fx:id="toolDescCol" text="Description" prefWidth="360"/>
        </columns>
    </TableView>
    <Label text="MCP servers" styleClass="section-title"/>
    <Label wrapText="true" styleClass="section-help"
           text="Configure Model Context Protocol servers. Their tools appear above once an McpToolSource client implementation is bound (currently a placeholder)."/>
    <TableView fx:id="mcpTable" editable="true" VBox.vgrow="ALWAYS" prefHeight="140">
        <columns>
            <TableColumn fx:id="mcpEnabledCol" text="On" prefWidth="40"/>
            <TableColumn fx:id="mcpNameCol" text="Name" prefWidth="130"/>
            <TableColumn fx:id="mcpTransportCol" text="Transport" prefWidth="80"/>
            <TableColumn fx:id="mcpEndpointCol" text="Command / URL" prefWidth="300"/>
            <TableColumn fx:id="mcpStatusCol" text="Status" prefWidth="200"/>
        </columns>
    </TableView>
    <HBox spacing="6" alignment="CENTER_LEFT">
        <TextField fx:id="mcpNameField" promptText="name" prefWidth="120"/>
        <ComboBox fx:id="mcpTransportCombo" prefWidth="90"/>
        <TextField fx:id="mcpEndpointField" promptText="command (stdio) or URL (http)" HBox.hgrow="ALWAYS"/>
        <Button text="Add server" onAction="#onAddServer"/>
        <Button text="Remove selected" onAction="#onRemoveServer"/>
    </HBox>
</VBox>
