<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="net.talaatharb.harness.ui.sections.ToolsSectionController" spacing="10" styleClass="section">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <Label text="Tools" styleClass="section-title"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <CheckBox fx:id="toolsEnabledCheck" text="Allow the agent to call tools"/>
        <Label text="Max tool output (chars)"/>
        <Spinner fx:id="maxOutputSpinner" prefWidth="110"/>
    </HBox>
    <TableView fx:id="toolTable" editable="true" prefHeight="180">
        <columns>
            <TableColumn fx:id="toolEnabledCol" text="On" prefWidth="40"/>
            <TableColumn fx:id="toolNameCol" text="Name" prefWidth="130"/>
            <TableColumn fx:id="toolRiskCol" text="Risk" prefWidth="90"/>
            <TableColumn fx:id="toolSourceCol" text="Source" prefWidth="90"/>
            <TableColumn fx:id="toolDescCol" text="Description" prefWidth="360"/>
        </columns>
    </TableView>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Agent-created tools:"/>
        <Button text="View source" onAction="#onViewDynamicSource"/>
        <Button text="Delete selected" onAction="#onDeleteDynamicTool"/>
        <Label fx:id="dynamicStatusLabel" wrapText="true" styleClass="section-help" HBox.hgrow="ALWAYS"/>
    </HBox>
    <Label text="Web search" styleClass="section-title"/>
    <Label wrapText="true" styleClass="section-help"
           text="Used by web_search_extract (returns page text to the agent) and web_search_index (adds pages to the knowledge base). Only free providers are offered; the same provider serves both tools. Pages are fetched politely: robots.txt is honoured and blocked or rate-limited sites are skipped."/>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Provider"/>
        <ComboBox fx:id="searchProviderCombo" prefWidth="240"/>
        <Label fx:id="searchProviderHelp" wrapText="true" styleClass="section-help" HBox.hgrow="ALWAYS"/>
    </HBox>
    <VBox fx:id="searchProviderConfigBox" spacing="6"/>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Results"/>
        <Spinner fx:id="webMaxResultsSpinner" editable="true" prefWidth="70"/>
        <Label text="Pages to read"/>
        <Spinner fx:id="webMaxPagesSpinner" editable="true" prefWidth="70"/>
        <Label text="Fetch timeout (s)"/>
        <Spinner fx:id="webFetchTimeoutSpinner" editable="true" prefWidth="80"/>
        <CheckBox fx:id="webRobotsCheck" text="Respect robots.txt"/>
    </HBox>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Chars per page"/>
        <Spinner fx:id="webCharsPerPageSpinner" editable="true" prefWidth="90"/>
        <Label text="Chars per call"/>
        <Spinner fx:id="webTotalCharsSpinner" editable="true" prefWidth="90"/>
        <Label text="Max page size (KB)"/>
        <Spinner fx:id="webMaxKbSpinner" editable="true" prefWidth="90"/>
    </HBox>
    <Label text="MCP servers" styleClass="section-title"/>
    <Label wrapText="true" styleClass="section-help"
           text="Model Context Protocol servers: stdio (a command the harness starts, e.g. npx -y @modelcontextprotocol/server-filesystem C:\work) or streamable HTTP (a URL). Their tools appear in the table above once connected. Env (stdio) / headers (HTTP) take KEY=VALUE; KEY2=VALUE2 — use ${VAR} to read a secret from the environment instead of storing it."/>
    <TableView fx:id="mcpTable" editable="true" VBox.vgrow="ALWAYS" prefHeight="140">
        <columns>
            <TableColumn fx:id="mcpEnabledCol" text="On" prefWidth="40"/>
            <TableColumn fx:id="mcpNameCol" text="Name" prefWidth="130"/>
            <TableColumn fx:id="mcpTransportCol" text="Transport" prefWidth="80"/>
            <TableColumn fx:id="mcpEndpointCol" text="Command / URL" prefWidth="260"/>
            <TableColumn fx:id="mcpEnvCol" text="Env / headers" prefWidth="110"/>
            <TableColumn fx:id="mcpStatusCol" text="Status" prefWidth="260"/>
        </columns>
    </TableView>
    <HBox spacing="6" alignment="CENTER_LEFT">
        <TextField fx:id="mcpNameField" promptText="name" prefWidth="120"/>
        <ComboBox fx:id="mcpTransportCombo" prefWidth="90"/>
        <TextField fx:id="mcpEndpointField" promptText="command (stdio) or URL (http)" HBox.hgrow="ALWAYS"/>
    </HBox>
    <HBox spacing="6" alignment="CENTER_LEFT">
        <TextField fx:id="mcpEnvField" promptText="env (stdio) / headers (http): KEY=VALUE; Authorization=Bearer ${TOKEN}" HBox.hgrow="ALWAYS"/>
        <Button fx:id="mcpAddButton" text="Add server" onAction="#onAddServer"/>
        <Button text="Remove selected" onAction="#onRemoveServer"/>
    </HBox>
    <HBox spacing="6" alignment="CENTER_LEFT">
        <Button fx:id="mcpTestButton" text="Test" onAction="#onTestServer">
            <tooltip><Tooltip text="Connect to the server in the fields above once and list its tools"/></tooltip>
        </Button>
        <Button text="Reconnect selected" onAction="#onReconnectServer">
            <tooltip><Tooltip text="Restart the connection of an applied server"/></tooltip>
        </Button>
        <Button text="Import mcp.json…" onAction="#onImportMcpJson">
            <tooltip><Tooltip text="Add servers from a Claude Desktop / VS Code / Cursor style mcp.json file"/></tooltip>
        </Button>
        <Label text="Connect timeout (s)"/>
        <Spinner fx:id="mcpConnectTimeoutSpinner" editable="true" prefWidth="80"/>
        <Label text="Tool call timeout (s)"/>
        <Spinner fx:id="mcpToolTimeoutSpinner" editable="true" prefWidth="80"/>
    </HBox>
    <Label fx:id="mcpMessageLabel" wrapText="true" styleClass="section-help"/>
</VBox>
