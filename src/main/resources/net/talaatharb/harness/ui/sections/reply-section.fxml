<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="net.talaatharb.harness.ui.sections.ReplySectionController" spacing="10" styleClass="section">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <Label text="Reply &amp; agentic UI" styleClass="section-title"/>
    <Label wrapText="true" styleClass="section-help"
           text="In Agentic UI mode the model is told it may embed ```ui JSON blocks; they are rendered as live components and buttons send their action back to the agent."/>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Mode"/>
        <ComboBox fx:id="modeCombo" prefWidth="180"/>
        <CheckBox fx:id="traceCheck" text="Show tool trace"/>
        <CheckBox fx:id="thinkingCheck" text="Show model thinking"/>
    </HBox>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <CheckBox fx:id="contextCheck" text="Show sent context (read-only inspector)"/>
        <CheckBox fx:id="timelineCheck" text="Show run timeline (context sizes, latency, tokens)"/>
    </HBox>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <CheckBox fx:id="markdownCheck" text="Render replies as Markdown"/>
        <CheckBox fx:id="imagesCheck" text="Allow all images in replies (fetches remote URLs)"/>
    </HBox>
    <Label text="Optional model response contract (0 or blank disables; applies until reset)"/>
    <HBox spacing="8">
        <Label text="Exact list items"/><Spinner fx:id="listSpinner" prefWidth="80" editable="true"/>
        <Label text="Max bullets"/><Spinner fx:id="bulletsSpinner" prefWidth="80" editable="true"/>
        <Label text="Repair attempts"/><Spinner fx:id="repairSpinner" prefWidth="80" editable="true"/>
    </HBox>
    <TextField fx:id="allowedField" promptText="Allowed exact replies separated by |, e.g. YES|NO"/>
    <Label text="Try a UI spec"/>
    <TextArea fx:id="specArea" prefRowCount="7" wrapText="true" styleClass="mono"/>
    <Button text="Render preview" onAction="#onPreview"/>
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox fx:id="previewBox" spacing="6">
            <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
        </VBox>
    </ScrollPane>
</VBox>
